<?xml version='1.0' encoding='utf-8'?>
<widget id="com.classicfc.games" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>经典怀旧游戏</name>
    <description>FC/NES 经典游戏合集，支持触屏操作</description>
    <author email="dev@classicfc.com" href="https://github.com/classicfc">
        ClassicFC Games
    </author>
    <content src="index.html" />
    
    <!-- 允许访问所有网络资源 -->
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    
    <!-- Android 平台配置 -->
    <platform name="android">
        <preference name="android-minSdkVersion" value="22" />
        <preference name="android-targetSdkVersion" value="33" />
        <preference name="Orientation" value="landscape" />
        <preference name="Fullscreen" value="true" />
        <preference name="StatusBarOverlaysWebView" value="true" />
        <preference name="StatusBarBackgroundColor" value="#0f172a" />
        <preference name="AndroidWindowSoftInputMode" value="adjustPan" />
        
        <icon density="ldpi" resource="res/icon/android/ldpi.png" />
        <icon density="mdpi" resource="res/icon/android/mdpi.png" />
        <icon density="hdpi" resource="res/icon/android/hdpi.png" />
        <icon density="xhdpi" resource="res/icon/android/xhdpi.png" />
        <icon density="xxhdpi" resource="res/icon/android/xxhdpi.png" />
        <icon density="xxxhdpi" resource="res/icon/android/xxxhdpi.png" />
        
        <splash density="land-hdpi" resource="res/screen/android/splash-land-hdpi.png" />
        <splash density="land-ldpi" resource="res/screen/android/splash-land-ldpi.png" />
        <splash density="land-mdpi" resource="res/screen/android/splash-land-mdpi.png" />
        <splash density="land-xhdpi" resource="res/screen/android/splash-land-xhdpi.png" />
        <splash density="land-xxhdpi" resource="res/screen/android/splash-land-xxhdpi.png" />
        <splash density="land-xxxhdpi" resource="res/screen/android/splash-land-xxxhdpi.png" />
        
        <config-file parent="/manifest/application" target="AndroidManifest.xml">
            <activity android:name="com.classicfc.games.MainActivity"
                android:screenOrientation="landscape"
                android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|uiMode"
                android:theme="@style/Theme.AppCompat.NoActionBar"
                android:launchMode="singleInstance"
                android:windowSoftInputMode="adjustPan">
                <intent-filter>
                    <action android:name="android.intent.action.MAIN" />
                    <category android:name="android.intent.category.LAUNCHER" />
                </intent-filter>
            </activity>
        </config-file>
    </platform>
    
    <!-- 全局配置 -->
    <preference name="DisallowOverscroll" value="true" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="SplashScreenDelay" value="2000" />
    <preference name="FadeSplashScreen" value="true" />
    <preference name="FadeSplashScreenDuration" value="500" />
    <preference name="ShowTitle" value="false" />
    <preference name="BackgroundColor" value="#0f172a" />
    
    <!-- 插件 -->
    <plugin name="cordova-plugin-whitelist" spec="^1.3.4" />
    <plugin name="cordova-plugin-statusbar" spec="^2.4.3" />
    <plugin name="cordova-plugin-splashscreen" spec="^6.0.0" />
    <plugin name="cordova-plugin-fullscreen" spec="^1.1.0" />
</widget>
